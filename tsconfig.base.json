{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@phipri/react-threadport": ["./packages/react-threadport/src/index.ts"],
      "@phipri/react-threadport-demo-shared": [
        "./packages/demo-shared/src/index.tsx"
      ],
      "@phipri/react-threadport-demo-shared/styles.css": [
        "./packages/demo-shared/src/styles.css"
      ]
    }
  }
}
