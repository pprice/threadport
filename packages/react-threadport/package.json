{
  "name": "@phipri/react-threadport",
  "version": "1.0.0",
  "description": "Headless virtualized chat viewport primitives for React.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "chat",
    "viewport",
    "virtualized",
    "headless",
    "react",
    "scroll"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm typecheck && pnpm build && node tests/package-smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "pnpm build && node tests/package-smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.24"
  },
  "peerDependencies": {
    "react": ">=18.3 || >=19"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsup": "^8.5.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
